---
const services = [
  {
    title: "Software a Medida",
    description: "Sistemas construidos desde cero para tu operación. Sin templates, sin compromisos.",
  },
  {
    title: "Integraciones y APIs",
    description: "Conectamos tus herramientas existentes para que trabajen como un solo sistema.",
  },
  {
    title: "SaaS verticales",
    description: "Productos listos para escalar en industrias donde el software genérico no alcanza.",
  },
  {
    title: "Consultoría de procesos",
    description: "Antes de escribir código, entendemos tu negocio. Así construimos lo que realmente necesitas.",
  },
  {
    title: "IA aplicada a operaciones",
    description: "Automatizaciones inteligentes que eliminan trabajo repetitivo y reducen errores humanos.",
  },
  {
    title: "Mantenimiento y evolución",
    description: "El software no termina cuando se entrega. Lo hacemos crecer con tu negocio.",
  },
];

const grays = ["#d6d2cd", "#c9c5c0", "#ddd9d4", "#ccc8c3", "#d1cdc8", "#e0dcd7"];
---

<style>
  .service-card {
    opacity: 0;
    transform: translateY(16px);
    background-color: var(--bg);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      background-color 0.35s ease;
    transition-delay: var(--delay, 0ms);
  }
  .service-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* contenido: siempre pegado abajo */
  .card-inner {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .card-title {
    color: #191919;
    transform: translateY(0);
    transition: color 0.35s ease, transform 0.35s ease;
  }

  /* descripción oculta abajo con max-height */
  .card-desc {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    color: rgba(255, 255, 255, 0.8);
    transition: max-height 0.35s ease, opacity 0.35s ease;
  }

  /* hover + mobile tap */
  .service-card:hover,
  .service-card.is-hovered {
    background-color: #191919;
  }

  .service-card:hover .card-title,
  .service-card.is-hovered .card-title {
    color: #ffffff;
    transform: translateY(-4px);
  }

  .service-card:hover .card-desc,
  .service-card.is-hovered .card-desc {
    max-height: 80px;
    opacity: 1;
    transform: translateY(-4px);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
    observer.observe(card);

    let timer: ReturnType<typeof setTimeout>;
    card.addEventListener('touchstart', () => {
      clearTimeout(timer);
      card.classList.add('is-hovered');
    }, { passive: true });
    card.addEventListener('touchend', () => {
      timer = setTimeout(() => card.classList.remove('is-hovered'), 400);
    });
    card.addEventListener('touchcancel', () => card.classList.remove('is-hovered'));
  });
</script>

<section
  id="servicios"
  class="bg-[#e2dfdb] w-full"
  style="background-image: linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px); background-size: 48px 48px;"
>
  <div class="max-w-[1019px] mx-auto border border-[#b5b5b5] border-solid">
    <!-- Header -->
    <div class="px-6 md:px-[55px] pt-[72px] pb-10 flex flex-col gap-3">
      <h2 class="font-sans font-normal text-[30px] leading-[1.15] tracking-[-0.07em] text-[#191919]">
        Seis problemas que resolvemos.
      </h2>
      <p class="text-base leading-relaxed tracking-[-0.07em] text-black/70 max-w-[511px]">
        Cada servicio existe porque hay un tipo de problema que el software genérico no puede resolver.
      </p>
    </div>

    <!-- Grid de servicios -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2 px-6 md:px-[55px] pb-6 md:pb-[55px]">
      {services.map((service, i) => (
        <div
          class="service-card animate-in relative h-[157px] overflow-hidden cursor-default"
          style={`--bg: ${grays[i]}; --delay: ${(i % 3) * 80}ms`}
        >
          <div class="card-inner">
            <span class="card-title font-sans font-normal text-[20px] leading-[1.2] tracking-[-0.07em]">
              {service.title}
            </span>
            <p class="card-desc font-sans font-normal text-[12px] leading-[1.4] tracking-[-0.04em]">
              {service.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

