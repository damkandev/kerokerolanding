---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Collaborator {
  name: string;
  image?: string;
  url?: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
  authorImage?: string;
  collaborators?: Collaborator[];
  tags?: string[];
  image?: string;
}

const { title, description, date, author, authorImage, collaborators = [], tags = [], image } = Astro.props;

const allAuthors: Collaborator[] = [
  ...(author ? [{ name: author, image: authorImage }] : []),
  ...collaborators,
];

const formattedDate = date.toLocaleDateString('es-CL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} type="article" image={image} />
  </head>
  <body class="bg-bg text-white font-sans antialiased">
    <Navbar />
    <main class="pt-[66px]">
      <article class="max-w-[720px] mx-auto px-6 py-16 md:py-24">

        <header class="mb-12">
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-5">
              {tags.map(tag => (
                <span class="text-[10px] uppercase tracking-widest text-accent/70 border border-accent/20 px-2.5 py-1">
                  {tag}
                </span>
              ))}
            </div>
          )}
          <h1 class="font-display text-3xl md:text-[2.5rem] text-white tracking-[-0.07em] leading-tight mb-5">
            {title}
          </h1>
          <div class="flex flex-col gap-3">
            {allAuthors.length > 0 && (
              <div class="flex items-center gap-2 flex-wrap">
                {allAuthors.map((person, i) => (
                  <>
                    {i > 0 && (
                      <span class="text-white/25 text-sm font-sans select-none">×</span>
                    )}
                    {person.url ? (
                      <a
                        href={person.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-2 group/author"
                      >
                        {person.image ? (
                          <img
                            src={person.image}
                            alt={person.name}
                            width="28"
                            height="28"
                            class="w-7 h-7 rounded-full object-cover border border-white/10 group-hover/author:border-accent/40 transition-colors duration-150"
                          />
                        ) : (
                          <span class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-[10px] text-white/50 uppercase font-sans group-hover/author:border-accent/40 transition-colors duration-150">
                            {person.name.charAt(0)}
                          </span>
                        )}
                        <span class="text-white/60 text-sm tracking-[-0.04em] group-hover/author:text-white transition-colors duration-150">
                          {person.name}
                        </span>
                      </a>
                    ) : (
                      <div class="flex items-center gap-2">
                        {person.image ? (
                          <img
                            src={person.image}
                            alt={person.name}
                            width="28"
                            height="28"
                            class="w-7 h-7 rounded-full object-cover border border-white/10"
                          />
                        ) : (
                          <span class="w-7 h-7 rounded-full bg-white/10 border border-white/10 flex items-center justify-center text-[10px] text-white/50 uppercase font-sans">
                            {person.name.charAt(0)}
                          </span>
                        )}
                        <span class="text-white/60 text-sm tracking-[-0.04em]">{person.name}</span>
                      </div>
                    )}
                  </>
                ))}
              </div>
            )}
            <time datetime={date.toISOString()} class="text-white/30 text-xs tracking-[-0.03em]">
              {formattedDate}
            </time>
          </div>
        </header>

        <div class="blog-content">
          <slot />
        </div>

      </article>
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<style>
  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: white;
    letter-spacing: -0.05em;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 0.875rem;
  }

  .blog-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: white;
    letter-spacing: -0.04em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-content :global(p) {
    color: rgba(255, 255, 255, 0.68);
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    color: rgba(255, 255, 255, 0.68);
    font-size: 1rem;
    line-height: 1.75;
    letter-spacing: -0.02em;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .blog-content :global(li) {
    margin-bottom: 0.375rem;
  }

  .blog-content :global(strong) {
    color: white;
    font-weight: 600;
  }

  .blog-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-content :global(a:hover) {
    opacity: 0.8;
  }

  .blog-content :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-left: 0;
    margin-bottom: 1.25rem;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
  }

  .blog-content :global(code) {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-accent);
    padding: 0.15em 0.4em;
    font-size: 0.875em;
    font-family: ui-monospace, monospace;
  }

  .blog-content :global(pre) {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .blog-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .blog-content :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 2.5rem 0;
  }
</style>
